# Environment and secret configuration
**/.env
**/.env.*
!**/.env.example

# Installed dependencies
**/node_modules/
**/vendor/
**/.gradle/

# Generated application and mobile build output
**/build/
**/dist/
**/android/app/build/
**/ios/build/
**/*.apk
**/*.aab
**/app-version.properties.lock
**/app-version.properties.tmp

# Local Android SDK settings and signing material
**/local.properties
**/google-services.json
**/*.jks
**/*.keystore

# Local runtime files
**/*.log
**/.DS_Store

# Installation database dumps contain private service credentials
Taxido_laravel/public/db.sql
Taxido_laravel/public/db/

# Locally provisioned payment and social-login credentials
**/.xcode.env.local

# Source-package update archives are retained locally, not versioned
Changed-files/*.zip

# Local caches, signing credentials and test capture artifacts
**/.metro-build-temp/
**/.cxx/
**/.externalNativeBuild/
**/.kotlin/
**/__pycache__/
**/ios/Pods/
**/*.p12
**/*.pfx
**/*.pem
**/*credentials*.xml
/*.zip
/*.png
/_stale-*/
/DROPA2Z_fixbackup-*/
